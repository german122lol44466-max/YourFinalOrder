/* Your Last Order — главное меню */

:root {
    --accent: #E8772E;
    --accent-dim: rgba(232, 119, 46, 0.18);
    --text: #E9E4D6;
    --text-dim: #8C877A;
    --panel: rgba(8, 9, 11, 0.82);
    --line: rgba(233, 228, 214, 0.14);
    -unity-font: url("../Art/Fonts/RussoOne-Regular.ttf");
    -unity-font-definition: initial;
    color: var(--text);
}

.root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.hidden {
    display: none;
}

.shade {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 60%;
}

.scanlines {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0.08;
}

/* ---------- левая колонка ---------- */

.side {
    position: absolute;
    left: 110px;
    top: 0;
    bottom: 0;
    width: 560px;
    justify-content: center;
}

.brand {
    margin-bottom: 36px;
    margin-left: -40px;
}

.logo-wrap {
    width: 620px;
    height: 349px;
}

.logo {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("../Art/Branding/Logo.png");
    -unity-background-scale-mode: scale-to-fit;
}

.logo-ghost {
    opacity: 0;
}

.logo-r {
    -unity-background-image-tint-color: rgb(255, 40, 70);
}

.logo-c {
    -unity-background-image-tint-color: rgb(40, 230, 255);
}

/* ---------- выбор робота ---------- */

.robot-cards {
    flex-direction: row;
    justify-content: space-between;
    margin: 8px 0 12px 0;
}

.robot-card {
    width: 32%;
    background-color: rgba(0, 0, 0, 0.45);
    border-width: 2px;
    border-color: var(--line);
    border-radius: 2px;
    padding: 0 0 10px 0;
    transition-property: border-color, translate, background-color;
    transition-duration: 0.15s;
}

.robot-card:hover {
    border-color: rgba(232, 119, 46, 0.6);
    translate: 0 -4px;
}

.robot-card--selected {
    border-color: var(--accent);
    background-color: rgba(232, 119, 46, 0.12);
}

.robot-card__image {
    height: 250px;
    -unity-background-scale-mode: scale-and-crop;
}

.robot-card__image--can { background-image: url("../Art/Robots/Portrait_Can.png"); }
.robot-card__image--toaster { background-image: url("../Art/Robots/Portrait_Toaster.png"); }
.robot-card__image--lantern { background-image: url("../Art/Robots/Portrait_Lantern.png"); }

.robot-card__name {
    font-size: 17px;
    color: var(--text);
    margin: 8px 10px 2px 10px;
    padding: 0;
}

.robot-card--selected .robot-card__name {
    color: var(--accent);
}

.robot-card__desc {
    font-size: 12px;
    color: var(--text-dim);
    white-space: normal;
    margin: 0 10px;
    padding: 0;
}

.title-wrap {
    height: 96px;
}

.title {
    position: absolute;
    left: 0;
    top: 0;
    font-size: 78px;
    -unity-font: url("../Art/Fonts/BlackOpsOne-Regular.ttf");
    -unity-font-definition: initial;
    color: var(--text);
    letter-spacing: 2px;
    white-space: nowrap;
    padding: 0;
    margin: 0;
    text-shadow: 0 0 12px rgba(232, 119, 46, 0.35);
}

.title-ghost {
    opacity: 0;
    text-shadow: none;
}

.title-r {
    color: rgba(255, 40, 70, 0.8);
}

.title-c {
    color: rgba(40, 230, 255, 0.8);
}

.tape {
    align-self: flex-start;
    background-color: #E2B232;
    padding: 4px 18px 2px 18px;
    rotate: -1.5deg;
    margin-top: 6px;
    margin-left: 4px;
}

.subtitle {
    font-size: 24px;
    color: #17140F;
    letter-spacing: 5px;
    padding: 0;
    margin: 0;
}

.tagline {
    margin-top: 14px;
    font-size: 14px;
    color: var(--text-dim);
    letter-spacing: 1px;
    padding: 0;
}

.screen {
    width: 100%;
}

.section {
    font-size: 14px;
    color: var(--accent);
    letter-spacing: 3px;
    margin: 18px 0 6px 0;
    padding: 0;
}

.hint {
    font-size: 13px;
    color: var(--text-dim);
    white-space: normal;
    margin: 4px 0 6px 0;
    padding: 0;
}

.row {
    flex-direction: row;
    align-items: center;
    margin: 4px 0;
}

.grow {
    flex-grow: 1;
}

/* ---------- кнопки ---------- */

.menu-button {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-left-width: 3px;
    border-left-color: var(--line);
    border-radius: 0;
    color: var(--text);
    font-size: 28px;
    -unity-text-align: middle-left;
    padding: 10px 18px;
    margin: 4px 0;
    letter-spacing: 1px;
    transition-property: translate, color, background-color, border-left-color;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.menu-button:hover {
    translate: 14px 0;
    color: var(--accent);
    background-color: var(--accent-dim);
    border-left-color: var(--accent);
}

.menu-button:active {
    translate: 18px 0;
    background-color: rgba(232, 119, 46, 0.3);
}

.menu-button:disabled {
    color: #4A4740;
    border-left-color: rgba(255, 255, 255, 0.05);
}

.menu-button--dim {
    font-size: 20px;
    color: var(--text-dim);
}

.menu-button--accent {
    border-left-color: var(--accent);
    color: var(--accent);
}

.small-button {
    background-color: rgba(233, 228, 214, 0.06);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 2px;
    color: var(--text);
    font-size: 16px;
    padding: 8px 14px;
    margin: 0 0 0 8px;
    transition-property: background-color, border-color, color;
    transition-duration: 0.12s;
}

.small-button:hover {
    background-color: var(--accent-dim);
    border-color: var(--accent);
    color: var(--accent);
}

.row > .small-button:first-child {
    margin-left: 0;
}

/* ---------- поля ---------- */

.field {
    margin: 0;
}

.field > .unity-base-text-field__input,
.field .unity-text-field__input {
    background-color: rgba(0, 0, 0, 0.55);
    border-color: var(--line);
    border-radius: 2px;
    color: var(--text);
    font-size: 16px;
    padding: 6px 10px;
    -unity-font: url("../Art/Fonts/RussoOne-Regular.ttf");
    -unity-font-definition: initial;
}

.port {
    width: 110px;
    margin-left: 8px;
}

.code {
    font-size: 18px;
    color: var(--text);
    padding: 0;
}

/* ---------- лобби ---------- */

.player-list {
    margin: 10px 0 14px 0;
}

.player-slot {
    flex-direction: row;
    align-items: center;
    height: 44px;
    padding: 0 12px;
    margin: 3px 0;
    background-color: rgba(0, 0, 0, 0.45);
    border-left-width: 3px;
    border-left-color: var(--accent);
}

.player-slot--empty {
    border-left-color: var(--line);
    background-color: rgba(0, 0, 0, 0.2);
}

.player-slot__index {
    font-size: 14px;
    color: var(--text-dim);
    width: 34px;
    padding: 0;
}

.player-slot__name {
    font-size: 18px;
    flex-grow: 1;
    padding: 0;
}

.player-slot--empty .player-slot__name {
    color: #55524A;
}

.player-slot__tag {
    font-size: 12px;
    color: var(--accent);
    letter-spacing: 2px;
    padding: 0;
}

/* ---------- настройки ---------- */

.settings {
    position: absolute;
    right: 90px;
    top: 90px;
    bottom: 90px;
    width: 820px;
    background-color: var(--panel);
    border-width: 1px;
    border-color: var(--line);
    padding: 26px 32px;
}

.settings-header {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-bottom-color: var(--line);
    padding-bottom: 12px;
}

.settings-title {
    font-size: 34px;
    -unity-font: url("../Art/Fonts/BlackOpsOne-Regular.ttf");
    -unity-font-definition: initial;
    padding: 0;
}

.tabs {
    flex-direction: row;
}

.tab {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    color: var(--text-dim);
    font-size: 16px;
    padding: 6px 12px;
    margin: 0 0 0 6px;
}

.tab:hover {
    color: var(--text);
}

.tab--active {
    color: var(--accent);
    border-bottom-color: var(--accent);
}

.settings-content {
    flex-grow: 1;
    margin-top: 16px;
}

.settings-footer {
    flex-direction: row;
    justify-content: flex-end;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: var(--line);
}

.setting {
    margin: 6px 0;
    min-height: 40px;
}

.setting .unity-base-field__label,
.setting > .unity-label {
    color: var(--text);
    font-size: 16px;
    min-width: 260px;
    -unity-font: url("../Art/Fonts/RussoOne-Regular.ttf");
    -unity-font-definition: initial;
}

.setting .unity-base-popup-field__input,
.setting .unity-base-field__input {
    background-color: rgba(0, 0, 0, 0.55);
    border-color: var(--line);
    color: var(--text);
    font-size: 15px;
}

.setting .unity-base-slider__dragger {
    background-color: var(--accent);
    border-color: var(--accent);
}

.setting .unity-base-slider__tracker {
    background-color: rgba(233, 228, 214, 0.15);
    border-color: rgba(0, 0, 0, 0);
}

.setting .unity-toggle__checkmark {
    background-color: rgba(0, 0, 0, 0.55);
    border-color: var(--line);
}

.setting-group {
    font-size: 13px;
    color: var(--accent);
    letter-spacing: 3px;
    margin: 18px 0 4px 0;
    padding: 0;
}

.crosshair-preview {
    width: 120px;
    height: 120px;
    align-self: center;
    margin: 10px 0;
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 1px;
    border-color: var(--line);
}

/* ---------- низ экрана ---------- */

.status {
    position: absolute;
    left: 110px;
    bottom: 70px;
    max-width: 560px;
    font-size: 16px;
    color: #FFB27A;
    background-color: rgba(0, 0, 0, 0.6);
    padding: 8px 12px;
    white-space: normal;
    border-left-width: 3px;
    border-left-color: var(--accent);
}

.footer {
    position: absolute;
    left: 110px;
    right: 40px;
    bottom: 24px;
    flex-direction: row;
    justify-content: space-between;
}

.footer-text {
    font-size: 13px;
    color: var(--text-dim);
    padding: 0;
}

.reality {
    color: rgba(233, 228, 214, 0.55);
    letter-spacing: 2px;
}

/* ---------- загрузка ---------- */

.loading {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.92);
    justify-content: center;
    align-items: center;
}

.loading-title {
    font-size: 44px;
    -unity-font: url("../Art/Fonts/BlackOpsOne-Regular.ttf");
    -unity-font-definition: initial;
    color: var(--text);
    letter-spacing: 4px;
    text-shadow: 0 0 18px rgba(232, 119, 46, 0.6);
}

.loading-log {
    margin-top: 18px;
    font-size: 14px;
    color: var(--text-dim);
    -unity-text-align: upper-center;
    white-space: normal;
}
